APP_NAME="Health Dashboard API"
ENVIRONMENT="dev"

# Postgres
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/health_dashboard"

# Auth JWT (générer une clé unique ; ne jamais commiter la vraie valeur)
JWT_SECRET="remplacer-par-une-cle-secrete-longue"
JWT_EXPIRE_MINUTES=10080

# CORS : URLs du frontend (local + prod Railway, séparées par des virgules)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# URL du frontend (liens mot de passe oublié)
FRONTEND_URL="http://localhost:5173"
PASSWORD_RESET_EXPIRE_MINUTES=60

# SMTP (optionnel — en dev sans SMTP, le lien apparaît dans les logs API et la réponse debug)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="noreply@example.com"
# SMTP_USE_TLS=true

# (Optionnel, avancé) Webhook Tasker — les utilisateurs finaux utilisent l'onglet Connexions
# HEALTH_SYNC_TOKEN="..."
# HEALTH_SYNC_USER_EMAIL="..."

