APP_NAME="Health Dashboard API"
ENVIRONMENT="dev"

# Postgres
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/health_dashboard"

# Auth JWT (générer une clé unique ; ne jamais commiter la vraie valeur)
JWT_SECRET="remplacer-par-une-cle-secrete-longue"
JWT_EXPIRE_MINUTES=10080

# CORS : URLs du frontend (local + prod Railway, séparées par des virgules)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

