# Modèle pour les variables Railway (service « api »).
# Copier vers .env.railway, remplir, puis coller dans l’onglet Variables Railway.
# Ne jamais commiter .env.railway.

APP_NAME="Health Dashboard API"
ENVIRONMENT="production"

# Référence Postgres Railway (postgresql:// accepté, conversion automatique)
DATABASE_URL="${{Postgres.DATABASE_URL}}"

JWT_SECRET="generer-avec-python3 -c \"import secrets; print(secrets.token_urlsafe(48))\""
JWT_EXPIRE_MINUTES=10080

# Après déploiement du frontend : URL publique exacte (sans slash final)
CORS_ORIGINS="https://web-production-e3f6a.up.railway.app"
FRONTEND_URL="https://web-production-e3f6a.up.railway.app"

# Mot de passe oublié — SMTP obligatoire en production (sinon aucun email n'est envoyé)
# Exemple Resend (https://resend.com) : domaine vérifié + clé API re_...
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=587
# SMTP_USER="resend"
# SMTP_PASSWORD="re_VOTRE_CLE_API"
# SMTP_FROM="onboarding@resend.dev"
# SMTP_USE_TLS=true

# Sync Tasker / Samsung Health (optionnel)
HEALTH_SYNC_TOKEN="generer-une-cle-longue-pour-tasker"
HEALTH_SYNC_USER_EMAIL="votre-compte@example.com"
